PORT=3000
DATABASE_PATH=./data/trustgraph.db
LOG_LEVEL=info

SCAN_FRESHNESS_WINDOW_MINUTES=15
HTTP_TIMEOUT_MS=10000

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

NPM_REGISTRY_BASE_URL=https://registry.npmjs.org
GITHUB_API_BASE_URL=https://api.github.com

# Optional. Raises GitHub's rate limit from 60/hour to 5,000/hour.
# Not required -- the npm-only collection path works with none at all.
GITHUB_TOKEN=
